{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"includes": ["src/**", "scripts/**", "test/**"]
	}
}
