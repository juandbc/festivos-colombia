{
	"name": "@juandbc/festivos-colombia",
	"version": "1.3.0",
	"description": "Módulo para obtener los días festivos de Colombia.",
	"type": "module",
	"main": "./src/index.cjs",
	"module": "./src/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/cjs/index.cjs"
			}
		}
	},
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build:esm": "tsc --project tsconfig.esm.json",
		"build:cjs": "cp -r src/cjs dist/cjs",
		"build": "npm run build:esm && npm run build:cjs",
		"test": "tsx --test test/holidays.test.ts"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"keywords": [
		"colombia",
		"colombian",
		"festivos",
		"holidays",
		"public-holidays",
		"colombian-holidays"
	],
	"author": "Juan David Bermudez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/juandbc/festivos-colombia.git"
	},
	"bugs": {
		"type": "git",
		"url": "https://github.com/juandbc/festivos-colombia/issues"
	},
	"homepage": "https://github.com/juandbc/festivos-colombia#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2"
	}
}
