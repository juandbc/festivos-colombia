{
	"compilerOptions": {
		"target": "ES2022",
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"rootDir": "src",
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "jest"]
	},
	"include": ["src/**/*", "test"],
	"exclude": ["node_modules", "dist"]
}
